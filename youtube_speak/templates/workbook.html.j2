<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — 口语练习册</title>
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: #2c2c2c;
    background: #f5f5f5;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0;
  }

  /* ── 封面标题区（紧凑版） ── */
  .hero {
    text-align: center;
    padding: 28px 20px 22px;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    color: #fff;
  }
  .hero h1 {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.4;
    margin-bottom: 6px;
  }
  .hero .meta {
    font-size: 12px;
    opacity: 0.7;
  }

  /* ── 横向 Tab 导航 ── */
  .tab-bar {
    display: flex;
    gap: 4px;
    padding: 10px 8px;
    background: #fff;
    border-bottom: 1px solid #eee;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .tab-bar::-webkit-scrollbar { display: none; }
  .tab-btn {
    flex: 0 0 auto;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 600;
    color: #888;
    background: #f5f5f5;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
    min-width: 44px;
    text-align: center;
  }
  .tab-btn:hover { color: #555; background: #eee; }
  .tab-btn.active {
    color: #fff;
    background: #e94560;
  }

  /* ── 内容面板 ── */
  .tab-panels {
    padding: 16px 16px 24px;
  }
  .tab-panel {
    display: none;
  }
  .tab-panel.active {
    display: block;
  }

  /* ── 摘要 ── */
  .summary-block {
    background: #f8f9fa;
    padding: 14px 18px;
    border-radius: 8px;
    margin-bottom: 12px;
  }
  .summary-block h3 {
    font-size: 14px;
    color: #e94560;
    margin-bottom: 6px;
  }
  .summary-block p {
    font-size: 14px;
    color: #444;
    line-height: 1.75;
  }

  /* ── 复述练习 ── */
  .retell-item {
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 12px;
    background: #fafafa;
  }
  .retell-item .hint-text {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a2e;
    margin-bottom: 4px;
  }
  .retell-item .hint-label {
    font-size: 11px;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .retell-item .show-answer-btn {
    display: inline-block;
    padding: 6px 16px;
    font-size: 12px;
    color: #e94560;
    background: #fff;
    border: 1.5px solid #e94560;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .retell-item .show-answer-btn:hover,
  .retell-item .show-answer-btn:active {
    background: #e94560;
    color: #fff;
  }
  .retell-item .reference-answer {
    display: none;
    margin-top: 10px;
    padding: 12px 16px;
    background: #fff;
    border-left: 3px solid #e94560;
    border-radius: 0 6px 6px 0;
    font-size: 13px;
    color: #444;
    line-height: 1.75;
  }
  .retell-item .reference-answer.show { display: block; }

  /* ── 词汇表 ── */
  .vocab-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .vocab-table th {
    background: #1a1a2e;
    color: #fff;
    padding: 8px 10px;
    text-align: left;
    font-weight: 600;
    font-size: 11px;
  }
  .vocab-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #eee;
    vertical-align: top;
  }
  .vocab-table .word-col { font-weight: 700; color: #1a1a2e; }
  .vocab-table .stars-col { white-space: nowrap; color: #f0a500; }
  .vocab-table .context-col { color: #666; font-size: 11px; }

  /* ── 金句 ── */
  .sentence-practice {
    padding: 14px 16px;
    margin-bottom: 10px;
    background: #fafafa;
    border-radius: 8px;
    border: 1px solid #eee;
  }
  .sentence-practice .pattern {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 6px;
    background: #fff3cd;
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .sentence-practice .example {
    font-size: 13px;
    color: #555;
    margin-bottom: 4px;
    padding-left: 10px;
    border-left: 2px solid #ddd;
  }
  .sentence-practice .info {
    font-size: 12px;
    color: #888;
    margin-bottom: 8px;
  }
  .sentence-practice .write-area {
    border: 1px dashed #ccc;
    min-height: 40px;
    border-radius: 4px;
    background: #fff;
  }

  /* ── 影子跟读 ── */
  .shadow-chunk {
    padding: 10px 14px;
    margin-bottom: 8px;
    border-left: 3px solid #e94560;
    background: #fff;
    border-radius: 0 6px 6px 0;
  }
  .shadow-chunk .chunk-header {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 2px;
  }
  .shadow-chunk .chunk-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    min-width: 22px;
    background: #e94560;
    color: #fff;
    border-radius: 50%;
    font-size: 10px;
    font-weight: 700;
    margin-top: 2px;
  }
  .shadow-chunk .text {
    font-size: 14px;
    font-weight: 500;
    color: #222;
    line-height: 1.6;
  }
  .shadow-chunk .hints {
    font-size: 11px;
    color: #888;
    margin-left: 30px;
    margin-top: 2px;
  }
  .practice-tip {
    margin-top: 14px;
    padding: 12px 16px;
    background: #f8f9fa;
    border-radius: 6px;
    font-size: 12px;
    color: #666;
  }

  /* ── 难点注释 ── */
  .difficult-item {
    padding: 12px 16px;
    margin-bottom: 10px;
    background: #fff8f0;
    border-radius: 8px;
    border: 1px solid #ffe0c0;
  }
  .difficult-item .orig {
    font-weight: 600;
    color: #c44;
    margin-bottom: 4px;
    font-size: 14px;
  }
  .difficult-item .explain {
    font-size: 13px;
    color: #555;
  }

  /* ── 统计 ── */
  .stats-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    text-align: center;
  }
  .stat-item .stat-num {
    font-size: 32px;
    font-weight: 800;
    color: #e94560;
    line-height: 1.2;
  }
  .stat-item .stat-label {
    font-size: 11px;
    color: #888;
  }

  /* ── 页脚 ── */
  .footer {
    text-align: center;
    padding: 20px;
    color: #bbb;
    font-size: 11px;
  }

  /* ── 打印样式 ── */
  @media print {
    body { background: #fff; }
    .container { max-width: 100%; }
    .tab-bar { display: none; }
    .tab-panel {
      display: block !important;
      margin-bottom: 16px;
      page-break-inside: avoid;
    }
    .tab-panel::before {
      content: attr(data-label);
      display: block;
      font-size: 16px;
      font-weight: 700;
      color: #1a1a2e;
      border-bottom: 2px solid #e94560;
      padding-bottom: 6px;
      margin-bottom: 12px;
    }
    .show-answer-btn { display: none !important; }
    .reference-answer { display: block !important; }
    .hero { padding: 20px 16px; }
  }
</style>
</head>
<body>

<div class="container">

  <!-- ═══ 封面 ═══ -->
  <div class="hero">
    <h1>{{ title }}</h1>
    <div class="meta">{{ uploader }} · {{ duration }} · {{ word_count }} 词</div>
  </div>

  <!-- ═══ Tab 导航 ═══ -->
  <div class="tab-bar" id="tabBar">
    <button class="tab-btn active" data-tab="tab-summary">摘要</button>
    <button class="tab-btn" data-tab="tab-retell">复述</button>
    {% if vocabulary %}<button class="tab-btn" data-tab="tab-vocab">词汇</button>{% endif %}
    {% if golden_sentences %}<button class="tab-btn" data-tab="tab-sentence">金句</button>{% endif %}
    {% if shadowing %}<button class="tab-btn" data-tab="tab-shadow">跟读</button>{% endif %}
    {% if difficult_spots %}<button class="tab-btn" data-tab="tab-difficult">难点</button>{% endif %}
    <button class="tab-btn" data-tab="tab-stats">统计</button>
  </div>

  <!-- ═══ 内容面板 ═══ -->
  <div class="tab-panels">

    <!-- 摘要 -->
    <div class="tab-panel active" id="tab-summary" data-label="摘要">
      {% if summary.summary_en %}
      <div class="summary-block">
        <h3>English Summary</h3>
        <p>{{ summary.summary_en }}</p>
      </div>
      {% endif %}
      {% if summary.summary_zh %}
      <div class="summary-block">
        <h3>中文概要</h3>
        <p>{{ summary.summary_zh }}</p>
      </div>
      {% endif %}
    </div>

    <!-- 复述 -->
    <div class="tab-panel" id="tab-retell" data-label="复述">
      <p style="color:#888; margin-bottom:12px; font-size:13px;">
        看提示词用自己的话复述，完成后点击按钮查看参考复述。
      </p>
      {% for item in summary.retelling_hints %}
      <div class="retell-item">
        <div class="hint-label">Hint {{ loop.index }}</div>
        <div class="hint-text">{{ item.hint }}</div>
        {% if item.reference_answer %}
        <button class="show-answer-btn" onclick="toggleAnswer(this)">📝 查看参考</button>
        <div class="reference-answer">{{ item.reference_answer }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    <!-- 词汇 -->
    {% if vocabulary %}
    <div class="tab-panel" id="tab-vocab" data-label="词汇">
      <p style="color:#888; margin-bottom:10px; font-size:12px;">
        ✏️ 遮盖中文注释列，看英文能否说出中文意思。
      </p>
      <table class="vocab-table">
        <thead>
          <tr><th>单词 / 短语</th><th>难度</th><th>出现语境</th><th>中文注释</th></tr>
        </thead>
        <tbody>
          {% for v in vocabulary %}
          <tr>
            <td class="word-col">{{ v.word }}</td>
            <td class="stars-col">{{ v.difficulty }}</td>
            <td class="context-col">{{ v.context_sentence }}</td>
            <td>{{ v.chinese_note }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    <!-- 金句 -->
    {% if golden_sentences %}
    <div class="tab-panel" id="tab-sentence" data-label="金句">
      <p style="color:#888; margin-bottom:12px; font-size:13px;">
        看模板和例句，在空白处用自己的例子仿写。
      </p>
      {% for gs in golden_sentences %}
      <div class="sentence-practice">
        <div class="pattern">{{ gs.pattern }}</div>
        <div class="example">📌 {{ gs.example }}</div>
        <div class="info">场景: {{ gs.usage_scenario }} | {{ gs.chinese_explanation }}</div>
        <div class="write-area"></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <!-- 跟读 -->
    {% if shadowing %}
    <div class="tab-panel" id="tab-shadow" data-label="跟读">
      <p style="color:#888; margin-bottom:10px; font-size:13px;">
        跟着原声逐段模仿，注意重音和连读。每段跟读 3-5 遍。
      </p>
      {% for s in shadowing %}
      <div class="shadow-chunk">
        <div class="chunk-header">
          <span class="chunk-num">{{ loop.index }}</span>
          <span class="text">{{ s.chunk_text }}</span>
        </div>
        <div class="hints">⏱ {{ s.pause_after }} &nbsp;|&nbsp; 🗣 {{ s.stress_hints }}</div>
      </div>
      {% endfor %}
      <div class="practice-tip">
        <strong>练习方法:</strong><br>
        1. 先听原声一遍，不跟读 &nbsp; 2. 逐段暂停模仿语音语调<br>
        3. 全文连贯跟读 2-3 遍 &nbsp; 4. 录音对比找差距
      </div>
    </div>
    {% endif %}

    <!-- 难点 -->
    {% if difficult_spots %}
    <div class="tab-panel" id="tab-difficult" data-label="难点">
      {% for d in difficult_spots %}
      <div class="difficult-item">
        <div class="orig">❓ "{{ d.sentence }}"</div>
        <div class="explain"><strong>难点</strong>: {{ d.difficulty_point }}</div>
        <div class="explain"><strong>解释</strong>: {{ d.chinese_note }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <!-- 统计 -->
    <div class="tab-panel" id="tab-stats" data-label="统计">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-num">{{ word_count }}</div>
          <div class="stat-label">字幕总词数</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">{{ vocab_count }}</div>
          <div class="stat-label">重点词汇</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">{{ sentence_count }}</div>
          <div class="stat-label">金句模板</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">{{ shadow_count }}</div>
          <div class="stat-label">跟读段落</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">{{ difficult_count }}</div>
          <div class="stat-label">难点注释</div>
        </div>
      </div>
      <p style="text-align:center; margin-top:18px; color:#aaa; font-size:12px;">
        Keep practicing! Consistency beats intensity. 🚀
      </p>
    </div>

  </div>

  <!-- ═══ 页脚 ═══ -->
  <div class="footer">
    Generated by YouTube Speak · {{ date }}
  </div>

</div>

<script>
  // Tab 切换
  var tabBar = document.getElementById('tabBar');
  tabBar.addEventListener('click', function(e) {
    var btn = e.target.closest('.tab-btn');
    if (!btn) return;

    // 切换按钮 active 态
    tabBar.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');

    // 切换面板
    var targetId = btn.getAttribute('data-tab');
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
    var target = document.getElementById(targetId);
    if (target) target.classList.add('active');
  });

  // 展开复述参考
  function toggleAnswer(btn) {
    var answer = btn.nextElementSibling;
    var isOpen = answer.classList.contains('show');
    if (isOpen) {
      answer.classList.remove('show');
      btn.textContent = '📝 查看参考';
    } else {
      answer.classList.add('show');
      btn.textContent = '📝 收起参考';
    }
  }
</script>

</body>
</html>
